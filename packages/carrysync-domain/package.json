{
  "name": "@carrysync/domain",
  "version": "0.1.0",
  "private": true,
  "description": "FieldLedger and QuizRelay domain logic, projections and services for CarrySync",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./field-ledger": { "types": "./dist/field-ledger/index.d.ts", "import": "./dist/field-ledger/index.js" },
    "./quiz-relay": { "types": "./dist/quiz-relay/index.d.ts", "import": "./dist/quiz-relay/index.js" },
    "./indexeddb": { "types": "./dist/indexeddb.d.ts", "import": "./dist/indexeddb.js" }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.."
  },
  "dependencies": { "dexie": "4.4.7", "zod": "4.6.7" },
  "peerDependencies": { "@carrysync/core": "0.1.0", "@carrysync/indexeddb": "0.1.0" },
  "devDependencies": { "@carrysync/core": "0.1.0", "@carrysync/indexeddb": "0.1.0" }
}
